{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "http://192.168.1.52:8888/api/:path*"
    },
    {
      "source": "/uploads/:path*",
      "destination": "http://192.168.1.52:8888/uploads/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
